<div class="card mb-3">
  <h5 class="card-header"><%= plus_one.name %></h5>
  <div class="card-body">
    <div class="row">
      <div class="col-md-4">
        Essenswünsche
      </div>
      <div class="col-md-8">
        <% if plus_one.diet.present? %>
          <pre><%= plus_one.diet %></pre>
        <% else %>
          <p>(keine)</p>
        <% end %>
      </div>
    </div>
    <div class="row">
      <div class="col-md-4">
        Kind
      </div>
      <div class="col-md-8">
        <p><%= plus_one.child ? 'Ja' : 'Nein' %></p>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12 text-right">
        <%= link_to 'Ändern', edit_guest_plus_one_path(plus_one.guest, plus_one), class: 'card-link', data: { disable_with: 'Wird geladen...' } %>
        <%= link_to 'Entfernen', guest_plus_one_path(plus_one.guest, plus_one), method: :delete, class: 'card-link', data: { disable_with: 'Wird entfernt...', confirm: 'Bist du sicher?' } %>
      </div>
    </div>
  </div>
</div>
